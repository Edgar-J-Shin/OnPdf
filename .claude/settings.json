{
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(ninja:*)",
      "Bash(vcpkg:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(qpdf:*)",
      "Bash(./build/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)"
    ]
  }
}
